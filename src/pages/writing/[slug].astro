---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Crumb from "../../components/Crumb.astro";

export async function getStaticPaths() {
  const writings = await getCollection("writing");
  return writings
    .filter((w) => w.data.public)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const kindLabel = { digest: "报告蒸馏", note: "笔记", retro: "复盘", essay: "随笔" };
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <section class="narrow page-head">
    <Crumb parent={{ href: "/writing/", label: "一些思考" }} />
    <span class="eyebrow">
      {kindLabel[post.data.kind]}{post.data.source ? ` · ${post.data.source}` : ""}
    </span>
    <h1>{post.data.title}</h1>
    <p class="sub">
      {post.data.date.toLocaleDateString("zh-CN", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </p>
  </section>

  <article class="narrow prose">
    <Content />
    <div class="post-nav">
      <a href="/writing/">← 回到文章列表</a>
      <a href="/">回到首页 →</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post-nav {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--line);
    font-family: var(--sans, sans-serif); font-size: 14.5px;
  }
  .post-nav a { color: var(--ink-soft); text-decoration: none; }
  .post-nav a:hover { color: var(--ochre-deep); }
</style>
