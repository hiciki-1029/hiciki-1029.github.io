---
import fs from "node:fs";
import path from "node:path";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Crumb from "../../components/Crumb.astro";

export async function getStaticPaths() {
  const writings = await getCollection("writing");
  return writings
    .filter((w) => w.data.public)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const kindLabel = { digest: "报告蒸馏", note: "笔记", retro: "复盘", essay: "随笔" };

/* og 分享卡路径。缺图就回落到通用卡（同 systems/[slug].astro 的说明）。 */
const ogPath = `/og/writing-${post.id}.png`;
const ogImage = fs.existsSync(path.join(process.cwd(), "public", ogPath)) ? ogPath : "/og/site.png";

const SITE = "https://www.hiciki.me";
const selfUrl = `${SITE}/writing/${post.id}/`;
const published = post.data.date.toISOString().slice(0, 10); // 只要日期，去掉 UTC 零点带来的时区歧义
const jsonLd = {
  "@type": "BlogPosting",
  "@id": `${selfUrl}#post`,
  headline: post.data.title,
  description: post.data.summary,
  url: selfUrl,
  mainEntityOfPage: selfUrl,
  image: `${SITE}${ogImage}`,
  inLanguage: "zh-CN",
  datePublished: published,
  dateModified: published,
  author: { "@id": `${SITE}/#person` },
  publisher: { "@id": `${SITE}/#person` },
  ...(post.data.source ? { about: post.data.source } : {}),
  isPartOf: { "@id": `${SITE}/#website` },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  image={ogImage}
  imageAlt={`${post.data.title} —— ${post.data.summary}`}
  jsonLd={jsonLd}
>
  <section class="narrow page-head">
    <Crumb parent={{ href: "/writing/", label: "一些思考" }} />
    <span class="eyebrow">
      {kindLabel[post.data.kind]}{post.data.source ? ` · ${post.data.source}` : ""}
    </span>
    <h1>{post.data.title}</h1>
    <p class="sub">
      {post.data.date.toLocaleDateString("zh-CN", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </p>
  </section>

  <article class="narrow prose">
    <Content />
    <div class="post-nav">
      <a href="/writing/">← 回到文章列表</a>
      <a href="/">回到首页 →</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post-nav {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--line);
    font-family: var(--sans, sans-serif); font-size: 14.5px;
  }
  .post-nav a { color: var(--ink-soft); text-decoration: none; }
  .post-nav a:hover { color: var(--ochre-deep); }
</style>
