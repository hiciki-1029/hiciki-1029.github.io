---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemCard from "../components/SystemCard.astro";
import HeroSystem from "../components/HeroSystem.astro";
import Marquee from "../components/Marquee.astro";

const systems = (await getCollection("systems")).sort(
  (a, b) => a.data.order - b.data.order
);
const writings = (await getCollection("writing"))
  .filter((w) => w.data.public)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const kindLabel = { digest: "蒸馏", note: "笔记", retro: "复盘", essay: "随笔" };

const stats = [
  { to: 69, prefix: "", suffix: "期日报", l: "另有 11 期周报，资讯智能体每天自动送达" },
  { to: 200, prefix: "约", suffix: "人", l: "新人培养自动化，横跨 23 个团队，通关率 86.5%" },
  { to: 24, prefix: "", suffix: "件·31人", l: "21 天 AI 创作赛，从作品到上台路演" },
  { to: 34, prefix: "", suffix: "个", l: "亲手写的 AI 技能，加 14 个常驻自动化" },
  { to: 24, prefix: "", suffix: "份", l: "前沿报告蒸馏，附来源、可回溯" },
];

const layers = [
  {
    key: "build",
    num: "01",
    kicker: "做系统",
    title: "把重复的事，做成能跑的应用",
    desc: "重复的事交给机器，判断和验收留给人。测评、资讯、知识库，都是真在跑的应用。",
    tags: ["常驻智能体", "全栈实现", "自动化运营"],
  },
  {
    key: "lead",
    num: "02",
    kicker: "带团队",
    title: "带一群人一起做 AI",
    desc: "一个人会用还不够。我牵头黑客松、运营兴趣小组，让零技术背景的 HR 也能做出能用的作品。",
    tags: ["AI 黑客松", "兴趣社群", "作品牵引"],
  },
  {
    key: "judge",
    num: "03",
    kicker: "判断与人",
    title: "管「人怎么想」这一层",
    desc: "十余年组织人才经验，加上教练功底，懂业务也懂人。AI 越强，这层反而越稀缺。",
    tags: ["ICF 教练", "组织诊断", "关键对话"],
  },
];

const road = [
  { yr: "2018–2021", co: "爱奇艺", rl: "HRBP / 培训" },
  { yr: "2021–2022", co: "小红书", rl: "人才发展" },
  { yr: "2022—今", co: "心动网络", rl: "人才发展 · 近 2000 人" },
];
---

<BaseLayout>
  <!-- 1 · Hero -->
  <section class="wrap hero hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">人才发展 × AI 工程化 × ICF 教练 · 上海</span>
      <h1>
        我运行着一套<br />
        「组织 × AI」的<em>工作系统</em>。
      </h1>
      <p class="lede">
        十余年做组织与人才发展。这两年我把重复的事交给系统，把判断和对话留给人——
        <strong>自己造能用的系统，也带整个 HR 团队一起做。</strong>
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/systems/">看看这些实践 <span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/resume/">读我的简历</a>
      </div>
    </div>
    <HeroSystem />
  </section>

  <div class="wrap"><Marquee /></div>

  <!-- 2 · 三层能力 -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">A</span>
      <h2>我的三块基本功</h2>
      <span class="hint">做系统 · 带团队 · 懂人</span>
    </div>
    <div class="layers">
      {
        layers.map((l) => (
          <div class={`layer layer-${l.key}`}>
            <div class="licon" aria-hidden="true">
              {l.key === "build" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="3" width="7" height="7" rx="2" /><rect x="14" y="3" width="7" height="7" rx="2" />
                  <rect x="3" y="14" width="7" height="7" rx="2" /><rect x="14" y="14" width="7" height="7" rx="2" />
                </svg>
              )}
              {l.key === "lead" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="9" cy="8" r="3.2" /><path d="M3.5 20c.6-3.4 3-5 5.5-5s4.9 1.6 5.5 5" />
                  <path d="M16 5.2a3 3 0 0 1 0 5.6M17.5 15.2c1.8.7 3 2.2 3.3 4.8" />
                </svg>
              )}
              {l.key === "judge" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.2 2" />
                </svg>
              )}
            </div>
            <span class="ghost-num">{l.num}</span>
            <div class="lkicker">{l.kicker}</div>
            <h3>{l.title}</h3>
            <p>{l.desc}</p>
            <div class="tags">{l.tags.map((t) => <span>{t}</span>)}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 3 · 活系统证据墙 -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">B</span>
      <h2>几件正在运行的真事</h2>
      <span class="hint">点进去看「问题—做法—验证—边界」</span>
    </div>
    <div class="bento">
      {systems.map((s) => <SystemCard sys={s} />)}
    </div>
  </section>

  <!-- 4 · 数字锚点 -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">C</span>
      <h2>数字比形容词可信</h2>
      <span class="hint">均为脱敏后的阶段性口径</span>
    </div>
    <div class="stats" id="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <div class="n">
              <span
                class="count"
                data-to={s.to}
                data-prefix={s.prefix}
                data-suffix={s.suffix}
              >{s.prefix}{s.to}{s.suffix}</span>
            </div>
            <div class="l">{s.l}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 5 · 现在在做 + 最新文字 -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">D</span>
      <h2>现在在做</h2>
      <span class="hint">随做随更</span>
    </div>
    <div class="now-grid">
      <div class="panel dark">
        <h3>/ now</h3>
        <ul class="now-list">
          <li>把「关键对话 Lab」打磨成能交给一线管理者反复练习的产品；</li>
          <li>推动团队 AI 作品从黑客松走向日常工作流；</li>
          <li>持续蒸馏组织与 AI 的前沿报告，每周一篇交叉洞察。</li>
        </ul>
        <p style="margin-top:16px;"><a href="/now/">看完整近况 →</a></p>
      </div>
      <div class="panel">
        <h3>最近写的</h3>
        <ul class="writing-list">
          {
            writings.map((w) => (
              <li>
                <a href={`/writing/${w.id}/`}>
                  <span class="d">
                    {w.data.date.toLocaleDateString("zh-CN", {
                      year: "numeric",
                      month: "2-digit",
                    })}{" "}
                    · {kindLabel[w.data.kind]}
                  </span>
                  <span>{w.data.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p style="margin-top:14px;"><a href="/writing/">全部文章 →</a></p>
      </div>
    </div>
  </section>

  <!-- 6 · 来路（工作经历从简） -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">E</span>
      <h2>来路</h2>
      <span class="hint">工作经历从简，详细版在简历页</span>
    </div>
    <div class="road">
      {
        road.map((r) => (
          <div class="stop">
            <div class="yr">{r.yr}</div>
            <div class="co">{r.co}</div>
            <div class="rl">{r.rl}</div>
          </div>
        ))
      }
    </div>
    <p class="road-more"><a href="/resume/">看完整简历与教育、认证 →</a></p>
  </section>
</BaseLayout>

<script>
  // 数字滚动：进入视口后从 0 递增到目标值
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var el = document.getElementById("stats");
    if (!el) return;
    var nums = Array.prototype.slice.call(el.querySelectorAll(".count"));
    function paint(node, v) {
      node.textContent =
        (node.dataset.prefix || "") + Math.round(v) + (node.dataset.suffix || "");
    }
    function run() {
      nums.forEach(function (node) {
        var to = parseInt(node.dataset.to || "0", 10);
        if (reduce) { paint(node, to); return; }
        var t0 = null, dur = 1100;
        function step(ts) {
          if (!t0) t0 = ts;
          var p = Math.min((ts - t0) / dur, 1);
          var ease = 1 - Math.pow(1 - p, 3);
          paint(node, to * ease);
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }
    if (reduce || !("IntersectionObserver" in window)) {
      nums.forEach(function (n) { paint(n, parseInt(n.dataset.to || "0", 10)); });
      return;
    }
    // 有 JS 才把初值归零、等进入视口再滚动；无 JS / 爬虫保留服务器渲染的终值
    nums.forEach(function (n) { paint(n, 0); });
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting) { run(); io.disconnect(); }
      });
    }, { threshold: 0.35 });
    io.observe(el);
  })();
</script>
