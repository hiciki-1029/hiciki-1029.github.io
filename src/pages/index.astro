---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemCard from "../components/SystemCard.astro";
import HeroSystem from "../components/HeroSystem.astro";
import Marquee from "../components/Marquee.astro";

const systems = (await getCollection("systems")).sort(
  (a, b) => a.data.order - b.data.order
);
// 首页只精选 4 个最能代表广度与差异的实践，其余进列表页
const homeOrder = [
  "knowledge-portal",
  "ssr-suite",
  "critical-conversation-lab",
  "ai-creation-contest",
];
const homeSystems = systems
  .filter((s) => homeOrder.includes(s.id))
  .sort((a, b) => homeOrder.indexOf(a.id) - homeOrder.indexOf(b.id));

const writings = (await getCollection("writing"))
  .filter((w) => w.data.public)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const kindLabel = { digest: "蒸馏", note: "笔记", retro: "复盘", essay: "随笔" };

// 数字做减法：只留三个最有冲击力的
const stats = [
  { to: 200, prefix: "约", suffix: "人", l: "新人培养自动化，横跨 23 个团队，通关率 86.5%" },
  { to: 24, prefix: "", suffix: "件·31人", l: "21 天 AI 创作赛，从作品到上台路演" },
  { to: 34, prefix: "", suffix: "个", l: "自建的 AI 技能，加 14 个定时自动化流程" },
];

const beliefs = [
  {
    k: "先看清",
    t: "动手之前，先走到一线，把真问题弄清楚。",
  },
  {
    k: "亲手做",
    t: "能交给 AI 的重复工作，就做成真正能用的产品，也带着同事一起做。",
  },
  {
    k: "看见人",
    t: "不急着给答案，慢下来，让一个人被真正听见、被看见。",
  },
];

const layers = [
  {
    key: "build",
    num: "01",
    kicker: "做系统",
    title: "把重复工作，做成能用的应用",
    desc: "重复的工作交给 AI，判断和验收留给自己。测评、资讯、知识库，都是日常在用的应用。",
    tags: ["AI 自动化", "独立做产品", "稳定运行"],
  },
  {
    key: "lead",
    num: "02",
    kicker: "带团队",
    title: "带一群人一起做 AI",
    desc: "一个人会用还不够。我牵头黑客松、运营兴趣小组，让零技术背景的 HR 也能做出能用的作品。",
    tags: ["AI 黑客松", "兴趣小组", "作品带动"],
  },
  {
    key: "judge",
    num: "03",
    kicker: "判断与人",
    title: "理解「人怎么想」这一层",
    desc: "十余年组织人才经验，加上教练功底，懂业务也懂人。AI 越强，这层反而越稀缺。",
    tags: ["ICF 教练", "组织诊断", "关键对话"],
  },
];

const road = [
  { yr: "2018–2021", co: "爱奇艺", rl: "HRBP / 培训" },
  { yr: "2021–2022", co: "小红书", rl: "人才发展" },
  { yr: "2022—今", co: "心动网络", rl: "人才发展 · 近 2000 人" },
];
---

<BaseLayout>
  <!-- 1 · Hero -->
  <section class="wrap hero hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">组织与人才发展 × AI 实践 × ICF 认证教练 · 上海</span>
      <h1>
        把重复的工作任务<span style="white-space:nowrap">交给 AI</span>，<br />
        把「<em>人</em>」留给自己。
      </h1>
      <p class="lede">
        我有十余年组织与人才发展的工作经历。教练让我更懂得理解人，我也用 AI 把一个个想法做成真正能用的产品——
        <strong>不只是自己做，还带着一群没有技术背景的 HR 一起做。</strong>
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/systems/">看看这些实践 <span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/about/">关于我</a>
        <a class="hero-mail" href="mailto:gongwenxi912@outlook.com">给我写信 <span class="arrow">→</span></a>
      </div>
    </div>
    <HeroSystem />
  </section>

  <div class="wrap"><Marquee /></div>

  <!-- 2 · 我相信 -->
  <section class="wrap section reveal">
    <div class="beliefs">
      <div class="beliefs-aside">
        <span class="beliefs-kicker">我相信</span>
        <p class="beliefs-sub">三件做人和做事里，一直没怎么变过的事。</p>
      </div>
      <div class="beliefs-grid">
        {
          beliefs.map((b) => (
            <div class="belief">
              <span class="b-k">{b.k}</span>
              <h3>{b.t}</h3>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3 · 我怎么工作 -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">01</span>
      <h2>我怎么工作</h2>
      <span class="hint">做系统 · 带团队 · 看见人</span>
      <img class="sec-stamp" src="/me/pose-build.jpg" alt="熙熙在电脑前把想法做成产品" loading="lazy" />
    </div>
    <div class="layers">
      {
        layers.map((l) => (
          <div class={`layer layer-${l.key}`}>
            <div class="licon" aria-hidden="true">
              {l.key === "build" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="3" width="7" height="7" rx="2" /><rect x="14" y="3" width="7" height="7" rx="2" />
                  <rect x="3" y="14" width="7" height="7" rx="2" /><rect x="14" y="14" width="7" height="7" rx="2" />
                </svg>
              )}
              {l.key === "lead" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="9" cy="8" r="3.2" /><path d="M3.5 20c.6-3.4 3-5 5.5-5s4.9 1.6 5.5 5" />
                  <path d="M16 5.2a3 3 0 0 1 0 5.6M17.5 15.2c1.8.7 3 2.2 3.3 4.8" />
                </svg>
              )}
              {l.key === "judge" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.2 2" />
                </svg>
              )}
            </div>
            <span class="ghost-num">{l.num}</span>
            <div class="lkicker">{l.kicker}</div>
            <h3>{l.title}</h3>
            <p>{l.desc}</p>
            <div class="tags">{l.tags.map((t) => <span>{t}</span>)}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 4 · 我怎么想（观点前置） -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">02</span>
      <h2>我怎么想</h2>
      <span class="hint">把想清楚的事，写下来</span>
    </div>
    <div class="think-grid">
      {
        writings.map((w) => (
          <a class="think" href={`/writing/${w.id}/`}>
            <span class="think-kind">{kindLabel[w.data.kind]}</span>
            <h3>{w.data.title}</h3>
            <p>{w.data.summary}</p>
            <span class="think-go">读这篇 <span class="arrow">→</span></span>
          </a>
        ))
      }
    </div>
    <p class="grid-more"><a href="/writing/">看全部文章 →</a></p>
  </section>

  <!-- 5 · 我做的东西（精选 4 个） -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">03</span>
      <h2>我做的东西</h2>
      <span class="hint">精选四个，点进去看「问题—做法—验证—边界」</span>
    </div>
    <div class="bento">
      {homeSystems.map((s) => <SystemCard sys={s} />)}
    </div>
    <p class="grid-more"><a href="/systems/">查看全部 {systems.length} 个 AI 实践 →</a></p>
  </section>

  <!-- 6 · 数字锚点 -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">04</span>
      <h2>几个数字</h2>
      <span class="hint">均为脱敏后的阶段性口径</span>
    </div>
    <div class="stats stats-3" id="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <div class="n">
              <span
                class="count"
                data-to={s.to}
                data-prefix={s.prefix}
                data-suffix={s.suffix}
              >{s.prefix}{s.to}{s.suffix}</span>
            </div>
            <div class="l">{s.l}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 7 · 最近在做 -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">05</span>
      <h2>最近在做</h2>
      <span class="hint">随做随更</span>
    </div>
    <div class="now-single">
      <div class="panel dark">
        <h3>/ now</h3>
        <ul class="now-list">
          <li>把「关键对话 Lab」打磨成能交给一线管理者反复练习的产品；</li>
          <li>让团队在黑客松里做的 AI 作品，真正进到日常工作里；</li>
          <li>持续读组织与 AI 的前沿报告，每周整理一篇交叉洞察。</li>
        </ul>
        <p style="margin-top:16px;"><a href="/now/">看完整近况 →</a></p>
      </div>
    </div>
  </section>

  <!-- 8 · 工作经历 -->
  <section class="wrap section reveal">
    <div class="sec-head">
      <span class="sec-index">06</span>
      <h2>工作经历</h2>
      <span class="hint">只放最近三段，完整版在简历页</span>
    </div>
    <div class="road">
      {
        road.map((r) => (
          <div class="stop">
            <div class="yr">{r.yr}</div>
            <div class="co">{r.co}</div>
            <div class="rl">{r.rl}</div>
          </div>
        ))
      }
    </div>
    <p class="road-more"><a href="/resume/">看完整简历与认证 →</a></p>
  </section>

  <!-- 9 · 联系 -->
  <section class="wrap section reveal">
    <div class="cta">
      <img class="cta-img" src="/me/pose-listen.jpg" alt="熙熙专注倾听的样子" loading="lazy" />
      <div class="cta-text">
        <h2>想聊聊，就给我写封信</h2>
        <p>人才发展、AI 要怎么在组织里落地，或者一次教练对话——都欢迎。</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href="mailto:gongwenxi912@outlook.com">给我写信 <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href="/about/">更多关于我</a>
        </div>
      </div>
      <div class="cta-qr">
        <img src="/me/wechat-qr.png" alt="熙熙的微信二维码，扫码加好友" width="108" height="108" loading="lazy" />
        <span>微信扫码加我</span>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // 数字滚动：进入视口后从 0 递增到目标值
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var el = document.getElementById("stats");
    if (!el) return;
    var nums = Array.prototype.slice.call(el.querySelectorAll(".count"));
    function paint(node, v) {
      node.textContent =
        (node.dataset.prefix || "") + Math.round(v) + (node.dataset.suffix || "");
    }
    function run() {
      nums.forEach(function (node) {
        var to = parseInt(node.dataset.to || "0", 10);
        if (reduce) { paint(node, to); return; }
        var t0 = null, dur = 1100;
        function step(ts) {
          if (!t0) t0 = ts;
          var p = Math.min((ts - t0) / dur, 1);
          var ease = 1 - Math.pow(1 - p, 3);
          paint(node, to * ease);
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }
    if (reduce || !("IntersectionObserver" in window)) {
      nums.forEach(function (n) { paint(n, parseInt(n.dataset.to || "0", 10)); });
      return;
    }
    // 有 JS 才把初值归零、等进入视口再滚动；无 JS / 爬虫保留服务器渲染的终值
    nums.forEach(function (n) { paint(n, 0); });
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting) { run(); io.disconnect(); }
      });
    }, { threshold: 0.35 });
    io.observe(el);
  })();
</script>
