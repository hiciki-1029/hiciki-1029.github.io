---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Crumb from "../components/Crumb.astro";
import SectionMark from "../components/SectionMark.astro";

const writings = (await getCollection("writing"))
  .filter((w) => w.data.public)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="近况"
  description="龚文熙现在正在做的事：关键对话 Lab、团队 AI 化与持续的前沿研究。/now 页面保持更新。"
>
  <section class="narrow page-head">
    <Crumb current="近况" />
    <span class="eyebrow">NOW · 近况</span>
    <h1>最近，我在忙这几件事</h1>
    <p class="sub">
      一份阶段记录。更新于 2026 年 10 月 14 日；下面的产品进度依据 10 月 10 日的记录整理。
    </p>
  </section>

  <article class="narrow prose now-journal">
    <section class="journal-entry">
    <h2><SectionMark kind="craft" />在打磨的产品</h2>
    <p>
      最近在调整关键对话 Lab 的体验：让开场更简单、更快进入练习，用短局与迷你复盘降低使用负担。它仍在打磨中；流程能跑通之后，还需要看真实使用者是否获得帮助。
    </p>
    </section>
    <section class="journal-entry">
    <h2><SectionMark kind="people" />在推动的组织变化</h2>
    <p>
      让团队在黑客松里练出的 AI 能力，沉淀进日常工作——不是办一次活动热闹一下，
      而是让 AI 和自动化真正接走重复的工作，把人还给判断和对话。
    </p>
    </section>
    <section class="journal-entry">
    <h2><SectionMark kind="book" />在持续的学习</h2>
    <p>
      持续读组织与 AI 的报告，也读教练和文学。我关注工具如何改变工作，也在练习倾听、留白和不急着给答案。
    </p>
    </section>
    <section class="journal-entry">
    <h2><SectionMark kind="pen" />最近写的</h2>
    <ul>
      {writings.map((w) => <li><a href={`/writing/${w.id}/`}>{w.data.title}</a></li>)}
    </ul>
    </section>
  </article>
</BaseLayout>

<style>
 .now-journal { margin-top:38px; }
 .journal-entry { position:relative; padding:0 0 26px 30px; border-left:1px solid var(--line-strong); margin-left:16px; }
 .journal-entry:last-child { border-color:transparent; }
 .journal-entry h2 { display:flex; align-items:center; gap:16px; margin:0 0 16px -47px; font-size:23px; }
 .journal-entry :global(.section-mark) { background:var(--paper); }
 .journal-entry p { margin-bottom:0; }
 .journal-entry ul { list-style:none; padding:0; }
 .journal-entry li { padding:9px 0; border-bottom:1px solid var(--line); font-size:15px; }
 .journal-entry li a { text-decoration:none; }
 @media(max-width:560px) { .journal-entry { padding-left:23px; } .journal-entry h2 { margin-left:-40px; gap:9px; font-size:21px; } }
</style>
