---
import fs from "node:fs";
import path from "node:path";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Pipeline from "../../components/Pipeline.astro";
import Crumb from "../../components/Crumb.astro";
import { practiceOutline } from "../../data/practice";

export async function getStaticPaths() {
  const systems = await getCollection("systems");
  return systems.map((sys) => ({ params: { slug: sys.id }, props: { sys } }));
}

const { sys } = Astro.props;
const { Content } = await render(sys);
const focus = practiceOutline.find(item => item.id === sys.id);
const badgeMap = {
  live: { cls: "live", label: "在运行 LIVE" },
  building: { cls: "building", label: "建设中 BUILDING" },
  method: { cls: "method", label: "方法 METHOD" },
} as const;
const badge = badgeMap[sys.data.status];

/* og 分享卡路径。缺图就回落到通用卡 —— 新增案例时忘了跑 `npm run og:build`，
   页面仍会照常构建，但分享出去不会是一张破图。构建期还有 scripts/check-og.mjs 硬拦。 */
const ogPath = `/og/system-${sys.id}.png`;
const ogImage = fs.existsSync(path.join(process.cwd(), "public", ogPath)) ? ogPath : "/og/site.png";

const SITE = "https://www.hiciki.me";
const selfUrl = `${SITE}/systems/${sys.id}/`;
/* year 是「2025—2026」这样的区间，取起始年份当作创建时间 */
const startYear = (sys.data.year.match(/\d{4}/) || [])[0];
const jsonLd = {
  "@type": "CreativeWork",
  "@id": `${selfUrl}#work`,
  name: sys.data.title,
  description: sys.data.tagline,
  abstract: sys.data.short ?? sys.data.tagline,
  url: selfUrl,
  image: `${SITE}${ogImage}`,
  inLanguage: "zh-CN",
  creator: { "@id": `${SITE}/#person` },
  author: { "@id": `${SITE}/#person` },
  keywords: sys.data.tags.join(", "),
  ...(startYear ? { dateCreated: startYear, temporalCoverage: sys.data.year.replace(/[—–-]/, "/") } : {}),
  ...(sys.data.link ? { sameAs: sys.data.link } : {}),
};
---

<BaseLayout
  title={focus?.title ?? sys.data.title}
  description={focus?.summary ?? sys.data.tagline}
  image={ogImage}
  imageAlt={`${sys.data.title} —— ${sys.data.short ?? sys.data.tagline}`}
  jsonLd={jsonLd}
>
  <section class="narrow page-head">
    <Crumb parent={{ href: "/systems/", label: "AI 实践" }} />
    <span class={`badge ${badge.cls}`} style="margin-bottom:18px;">
      <span class="dot"></span>{badge.label} · {sys.data.year}
    </span>
    {focus && <span class="focus-perspective">{focus.perspective}</span>}
    <h1>{focus?.title ?? sys.data.title}</h1>
    <p class="sub">{focus?.question ?? sys.data.tagline}</p>
    {focus && <p class="focus-summary">{focus.summary}</p>}
    <div class="cert-chips" style="margin-top:18px;">
      {sys.data.tags.map((t) => <span>{t}</span>)}
    </div>
  </section>

  {sys.id === "ssr-suite" && <section class="narrow cultivation" aria-labelledby="cultivation-title">
    <h2 id="cultivation-title">把培养的几件事连起来</h2>
    <div class="cultivation-parts">
      <div><span>01 · 真实任务</span><p>AI 创作大赛让新人从问题出发，组队做出能被体验的作品。</p></div>
      <div><span>02 · 过程支持</span><p>学习平台、报名组队与 AI 班班承接资料、参与和重复答疑。</p></div>
      <div><span>03 · 看见具体的人</span><p>通过作品、讲述与反馈，了解一个人的选择和推进过程，留下后续继续观察的线索。</p></div>
    </div>
  </section>}

  {focus && focus.related.length > 0 && <section class="narrow related-practice" aria-label="实践之间的关系">
    {focus.related.map(item => <a href={`/systems/${item.id}/`}><span>{item.label}</span><strong>{item.title} ↗</strong><p>{item.description}</p></a>)}
  </section>}

  {
    sys.data.pipeline.length > 0 && (
      <section class="wrap" style="padding-top:10px;">
        <div class="panel" style="padding:22px 24px;">
          <div class="pipeline-title">{focus ? "从设计到实践" : "系统链路"}</div>
          <Pipeline steps={sys.data.pipeline} />
        </div>
      </section>
    )
  }

  <article class="narrow prose">
    {focus && <div class="source-intro"><h2>{sys.data.title}</h2><p>{sys.data.tagline}</p></div>}
    <Content />

    {
      sys.data.media.length > 0 && (
        <div class="media-block">
          <div class="media-label">作品实拍</div>
          <div class="gallery">
            {sys.data.media.map((m) =>
              m.type === "image" ? (
                <figure class="shot">
                  <img src={m.src} alt={m.caption} loading="lazy" />
                  {m.caption && <figcaption>{m.caption}</figcaption>}
                </figure>
              ) : (
                <figure class="shot">
                  <video controls preload="none" poster={m.poster} src={m.src}></video>
                  {m.caption && <figcaption>{m.caption}</figcaption>}
                </figure>
              )
            )}
          </div>
        </div>
      )
    }

    {
      sys.data.link && (
        <p style="margin-top:32px;">
          <a class="btn btn-primary" href={sys.data.link} target="_blank" rel="noopener">
            {sys.data.linkLabel ?? "查看相关链接"} <span class="arrow">↗</span>
          </a>
        </p>
      )
    }

    <div class="post-nav">
      <a href="/systems/">← 回到 AI 实践</a>
      <a href="/">回到首页 →</a>
    </div>
  </article>
</BaseLayout>

<style>
  .cultivation { margin-bottom:26px; }
  .cultivation h2 { font-family:var(--serif); font-size:21px; margin:0 0 18px; }
  .cultivation-parts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
  .cultivation-parts > div { padding-top:14px; border-top:1px solid var(--line-strong); }
  .cultivation-parts span { font-size:12px; color:var(--ochre-deep); }
  .cultivation-parts p { margin:8px 0 0; font-size:13px; color:var(--ink-soft); line-height:1.8; }
  @media(max-width:600px) { .cultivation-parts { grid-template-columns:1fr; gap:14px; } }
  .focus-perspective { display:block; margin:6px 0 12px; color:var(--ochre-deep); font-size:12px; }
  .focus-summary { margin:18px 0 0; color:var(--ink-soft); font-size:15px; line-height:1.9; max-width:40em; }
  .related-practice { display:flex; gap:16px; margin-bottom:24px; }
  .related-practice a { display:block; flex:1; min-width:0; padding:18px 20px; border:1px solid var(--line); border-radius:var(--r-md); background:var(--paper-2); text-decoration:none; color:var(--ink); }
  .related-practice span { display:block; color:var(--ochre-deep); font-size:11px; margin-bottom:6px; }
  .related-practice strong { font-family:var(--serif); font-size:17px; font-weight:600; }
  .related-practice p { margin:8px 0 0; color:var(--muted); font-size:13px; line-height:1.7; }
  .source-intro { padding-bottom:14px; border-bottom:1px solid var(--line); }
  @media(max-width:600px) { .related-practice { flex-direction:column; } }
  .media-label {
    font-family: var(--sans, sans-serif); font-size: 12.5px; font-weight: 600;
    letter-spacing: .14em; color: var(--ochre-deep); margin-bottom: 14px;
  }
  .media-block .gallery { margin-top: 0; margin-bottom: 30px; }
  .post-nav {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--line);
    font-family: var(--sans, sans-serif); font-size: 14.5px;
  }
  .post-nav a { color: var(--ink-soft); text-decoration: none; }
  .post-nav a:hover { color: var(--ochre-deep); }
</style>
