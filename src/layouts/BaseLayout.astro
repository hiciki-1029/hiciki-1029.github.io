---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** 分享卡图片路径。默认用站点通用卡；项目页/文章页传各自生成的卡 */
  image?: string;
  /** 表达该页的一句话，供 og:image:alt 与读屏使用 */
  imageAlt?: string;
  /** 该页自己的结构化数据节点，会并入页面底部的 @graph */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = "龚文熙（熙熙 / Ciki）：十余年组织与人才发展工作经历，以教练洞察人性，用 AI 把想法做成真正能用的产品。",
  image = "/og/site.png",
  imageAlt = "熙熙 Ciki · 组织与人才发展 × AI 实践 × ICF 认证教练",
  jsonLd,
} = Astro.props;
const SITE = "https://www.hiciki.me";
const site = (Astro.site ?? SITE).toString().replace(/\/+$/, "");
const fullTitle = title ? `${title} · 熙熙 Ciki` : "熙熙 Ciki · 组织 × AI 工作系统";
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE);
const ogImage = new URL(image, Astro.site ?? SITE);

const jsonLdGraph = [
  {
    "@type": "Person",
    "@id": `${site}/#person`,
    name: "龚文熙",
    alternateName: ["熙熙", "Ciki", "嘻嘻是熙熙"],
    url: `${site}/`,
    image: `${site}/me/avatar.jpg`,
    jobTitle: "组织与人才发展",
    description: "十余年组织与人才发展工作经历，以教练洞察人性，用 AI 把想法做成真正能用的产品。",
    address: { "@type": "PostalAddress", addressLocality: "上海", addressCountry: "CN" },
    email: "mailto:gongwenxi912@outlook.com",
    knowsAbout: ["组织发展", "人才发展", "教练对话", "AI 工作流", "知识管理", "人才测评"],
    sameAs: ["https://github.com/hiciki-1029"],
  },
  {
    "@type": "WebSite",
    "@id": `${site}/#website`,
    url: `${site}/`,
    name: "熙熙 Ciki",
    inLanguage: "zh-CN",
    publisher: { "@id": `${site}/#person` },
    author: { "@id": `${site}/#person` },
  },
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="龚文熙 Ciki" />
    <meta name="theme-color" content="#faf8f4" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="熙熙 Ciki" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={canonical} />
    <!-- 分享卡：飞书 / 领英 / X / Slack / Telegram 严格遵守；微信会优先取这里的图 -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{fullTitle}</title>

    <!-- 无 JS 时正文不应被渐入动效藏住 -->
    <noscript><style>.reveal{opacity:1 !important;transform:none !important}</style></noscript>

    <!-- 字体自托管于 /fonts/（见 scripts/build-fonts.mjs）。
         原来走 fonts.googleapis.com / fonts.gstatic.com，大陆常规网络不可达，
         衬线标题会静默退化成本机宋体。汉字子集按实际用字裁剪，行为与走 Google 一致。 -->

    <!-- 结构化数据：告诉搜索引擎这是谁、写过什么、做过什么。
         节点随内容 frontmatter 变化，改了 frontmatter 重跑构建即可，不需要手维护。 -->
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": jsonLdGraph })} />
  </head>
  <body>
    <a class="skip" href="#content">跳到正文</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />

    <!-- 联系弹窗：任何带 data-contact 的元素点击后打开 -->
    <div class="contact-overlay" id="contactModal" aria-hidden="true">
      <div class="contact-card" role="dialog" aria-modal="true" aria-label="联系熙熙">
        <button class="contact-x" type="button" data-contact-close aria-label="关闭">✕</button>
        <h3>联系熙熙</h3>
        <p class="contact-sub">人才发展、AI 如何在组织里落地，或者一次教练对话——都欢迎找我聊聊。</p>
        <div class="contact-grid">
          <div class="contact-wechat">
            <img src="/me/wechat-qr.png" width="132" height="132" alt="熙熙的微信二维码，扫码加好友" loading="lazy" />
            <span>微信扫码加我</span>
          </div>
          <div class="contact-mail">
            <div class="cm-label">邮箱</div>
            <button class="cm-copy" type="button" data-copy="gongwenxi912@outlook.com">
              <span class="cm-addr">gongwenxi912@outlook.com</span>
              <span class="cm-btn">复制</span>
            </button>
            <a class="cm-direct" href="mailto:gongwenxi912@outlook.com">或直接写封邮件 →</a>
            <div class="cm-note">看到后我会尽快回复 :)</div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // 克制动效：仅在元素进入视口时渐入；不支持/减少动态时 CSS 已兜底为常显
      (function () {
        try {
          var els = document.querySelectorAll(".reveal");
          if (!("IntersectionObserver" in window)) {
            els.forEach(function (el) { el.classList.add("in"); });
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add("in");
                  io.unobserve(e.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: "0px 0px -8% 0px" }
          );
          els.forEach(function (el) { io.observe(el); });
        } catch (err) {
          document.querySelectorAll(".reveal").forEach(function (el) { el.classList.add("in"); });
        }
      })();

      // 联系弹窗：data-contact 打开，遮罩/✕/Esc 关闭；邮箱一键复制
      (function () {
        try {
          var modal = document.getElementById("contactModal");
          if (!modal) return;
          var lastFocus = null;
          function open(e) {
            if (e) e.preventDefault();
            lastFocus = document.activeElement;
            modal.classList.add("open");
            modal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
            var x = modal.querySelector(".contact-x");
            if (x) x.focus();
          }
          function close() {
            modal.classList.remove("open");
            modal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
            if (lastFocus && lastFocus.focus) lastFocus.focus();
          }
          document.addEventListener("click", function (e) {
            var opener = e.target.closest ? e.target.closest("[data-contact]") : null;
            if (opener) return open(e);
            if (e.target === modal || (e.target.closest && e.target.closest("[data-contact-close]"))) return close();
          });
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && modal.classList.contains("open")) close();
          });
          var copyBtn = modal.querySelector("[data-copy]");
          if (copyBtn) {
            copyBtn.addEventListener("click", function () {
              var text = copyBtn.getAttribute("data-copy") || "";
              var tag = copyBtn.querySelector(".cm-btn");
              function done() {
                copyBtn.classList.add("copied");
                if (tag) tag.textContent = "已复制 ✓";
                setTimeout(function () {
                  copyBtn.classList.remove("copied");
                  if (tag) tag.textContent = "复制";
                }, 1600);
              }
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(done).catch(fallback);
              } else { fallback(); }
              function fallback() {
                var ta = document.createElement("textarea");
                ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
                document.body.appendChild(ta); ta.select();
                try { document.execCommand("copy"); done(); } catch (err) {}
                document.body.removeChild(ta);
              }
            });
          }
        } catch (err) {}
      })();
    </script>
  </body>
</html>
