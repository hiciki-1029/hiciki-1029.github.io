---
const words = [
  "一线访谈", "人才培养", "AI 创作大赛", "教练对话", "知识库门户",
  "在线测评", "自动化工作流", "带团队做 AI", "每日情报", "关键对话",
  "21 天共创", "34 个自建技能", "14 个常驻自动化", "可溯源问答",
];
const row = [...words, ...words];
---

<div class="marquee" aria-hidden="true">
  <div class="m-track">
    {row.map((w) => <span class="m-word">{w}<i>✦</i></span>)}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden; margin: 8px 0 0; padding: 16px 0;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .m-track { display: inline-flex; white-space: nowrap; animation: scrollx 32s linear infinite; }
  .marquee:hover .m-track { animation-play-state: paused; }
  .m-word {
    display: inline-flex; align-items: center; gap: 14px;
    font-family: var(--serif); font-size: 16px; color: var(--ink-soft); padding: 0 18px;
  }
  .m-word i { font-style: normal; color: var(--ochre-soft); font-size: 11px; }
  @keyframes scrollx { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .m-track { animation: none; } }
</style>
