---
interface Props {
  steps: string[];
}
const { steps } = Astro.props;
---

{
  steps.length > 0 && (
    <ol class="pipeline" aria-label="实践过程">
      {steps.map((s, i) => (
        <li class="pstep">
          <span class="pdot">{i + 1}</span>
          <span class="plabel">{s}</span>
        </li>
      ))}
    </ol>
  )
}

<style>
  .pipeline { display: grid; grid-template-columns: repeat(auto-fit, minmax(125px, 1fr)); gap: 14px; padding: 0; margin: 16px 0 0; list-style: none; }
  .pstep { display: flex; align-items: flex-start; gap: 8px; min-width: 0; }
  .pdot { flex: none; }
  .plabel { padding: 0; background: transparent; white-space: normal; }
  @media (max-width: 560px) { .pipeline { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } }
</style>
