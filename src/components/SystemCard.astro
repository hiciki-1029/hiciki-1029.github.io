---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  sys: CollectionEntry<"systems">;
}
const { sys } = Astro.props;
const { data } = sys;

const badgeMap = {
  live: { cls: "live", label: "在运行 LIVE" },
  building: { cls: "building", label: "建设中 BUILDING" },
  method: { cls: "method", label: "方法 METHOD" },
} as const;
const badge = badgeMap[data.status];

// 卡片封面：优先用设计封面 cover；没填则回退到第一个媒体（视频 poster / 图片 src）
const media = data.media ?? [];
const firstMedia = media[0];
const fallback = firstMedia
  ? firstMedia.type === "image"
    ? firstMedia.src
    : firstMedia.poster
  : null;
const cover = data.cover ?? fallback;
// 只要案例里含视频，就标「实机演示」
const hasVideo = media.some((m) => m.type === "video");
---

<a class={`sys span-${data.span} ${data.featured ? "feature" : ""} reveal`} href={`/systems/${sys.id}/`}>
  {cover && (
    <div class="cover">
      <img src={cover} alt="" loading="lazy" decoding="async" />
      {hasVideo && <span class="cov-tag">实机演示</span>}
    </div>
  )}
  <span class="go" aria-hidden="true">↗</span>
  <div class="top">
    <span class={`badge ${badge.cls}`}><span class="dot"></span>{badge.label}</span>
  </div>
  <h3>{data.title}</h3>
  <p>{data.short ?? data.tagline}</p>
  <div class="meta">
    <span>{data.year}</span>
    {data.tags.map((t) => <span>{t}</span>)}
  </div>
</a>
