---
import type { CollectionEntry } from "astro:content";

interface Props {
  sys: CollectionEntry<"systems">;
}
const { sys } = Astro.props;
const { data } = sys;

const badgeMap = {
  live: { cls: "live", label: "在运行 LIVE" },
  building: { cls: "building", label: "建设中 BUILDING" },
  method: { cls: "method", label: "方法 METHOD" },
} as const;
const badge = badgeMap[data.status];

// 有公开演示时优先展示真实画面；设计封面单独标识，避免混淆。
const media = data.media ?? [];
const firstMedia = media[0];
const fallback = firstMedia
  ? firstMedia.type === "image"
    ? firstMedia.src
    : firstMedia.poster
  : null;
const cover = fallback ?? data.cover;
---

<a class={`sys span-${data.span} ${data.featured ? "feature" : ""}`} href={`/systems/${sys.id}/`}>
  {cover && (
    <div class:list={["cover", { "demo-cover": Boolean(fallback) }]}>
      <img src={cover} alt="" loading="lazy" decoding="async" />
      <span class="cov-tag">{fallback ? "演示画面" : "概念插画"}</span>
    </div>
  )}
  <span class="go" aria-hidden="true">↗</span>
  <div class="top">
    <span class={`badge ${badge.cls}`}><span class="dot"></span>{badge.label}</span>
  </div>
  {data.question && <span class="case-question">{data.question}</span>}
  <h3>{data.title}</h3>
  <p>{data.short ?? data.tagline}</p>
  <div class="meta">
    <span>{data.year}</span>
    {data.tags.map((t) => <span>{t}</span>)}
  </div>
</a>

<style>
  .demo-cover { background:#eeeae4; }
  .demo-cover img { object-fit:contain; padding:14px; }
</style>
