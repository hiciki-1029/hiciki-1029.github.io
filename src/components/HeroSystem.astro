---
// 抽象的「个人 AI 工作系统」星图：中心是人的判断，外围是在运行的能力节点
const nodes = [
  { label: "采集", x: 220, y: 58, c: "sage" },
  { label: "蒸馏", x: 372, y: 132, c: "ochre" },
  { label: "自动推送", x: 378, y: 300, c: "sage" },
  { label: "常驻服务", x: 220, y: 386, c: "ochre" },
  { label: "多模型路由", x: 62, y: 300, c: "sage" },
  { label: "知识库", x: 68, y: 132, c: "ochre" },
];
---

<div class="hero-visual" aria-hidden="true">
  <svg viewBox="0 0 440 440" fill="none" xmlns="http://www.w3.org/2000/svg" role="img">
    <!-- 同心环 -->
    <circle cx="220" cy="220" r="104" fill="#efe9dc" opacity="0.55" />
    <circle cx="220" cy="220" r="150" stroke="#d2c8b3" stroke-width="1" stroke-dasharray="2 6" />
    <circle cx="220" cy="220" r="196" stroke="#e4dccb" stroke-width="1" />

    <!-- 连线 -->
    {nodes.map((n) => <line x1="220" y1="220" x2={n.x} y2={n.y} stroke="#c2b69e" stroke-width="1.3" class="link" />)}

    <!-- 沿线流动的光点 -->
    {nodes.map((n, i) => (
      <circle r="3.6" class={`flow ${n.c}`}>
        <animateMotion
          dur={`${3.2 + (i % 3) * 0.7}s`}
          repeatCount="indefinite"
          path={`M220,220 L${n.x},${n.y}`}
          begin={`${i * 0.45}s`}
        />
      </circle>
    ))}

    <!-- 外围节点 -->
    {nodes.map((n) => (
      <g class="sat">
        <rect x={n.x - 44} y={n.y - 19} width="88" height="38" rx="19" fill="#fbf8f1" stroke="#d3c8b2" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="13.5" fill="#3d3a34" font-family="'Noto Sans SC',sans-serif">{n.label}</text>
      </g>
    ))}

    <!-- 中心节点 -->
    <g class="core">
      <rect x="150" y="184" width="140" height="72" rx="22" fill="#25231f" />
      <text x="220" y="214" text-anchor="middle" font-size="15" fill="#f5f1e8" font-family="'Noto Serif SC',serif" font-weight="700">人的判断</text>
      <text x="220" y="238" text-anchor="middle" font-size="11.5" fill="#bdb6a6" font-family="'Noto Sans SC',sans-serif">验收 · 回写 · 对话</text>
    </g>
  </svg>
</div>

<style>
  .hero-visual { width: 100%; max-width: 460px; margin-left: auto; min-width: 0; }
  .hero-visual svg { width: 100%; height: auto; display: block; }
  .link { stroke-dasharray: 4 5; animation: dash 14s linear infinite; }
  .flow.sage { fill: #63756a; }
  .flow.ochre { fill: #b07a2b; }
  .sat { animation: floaty 6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .sat:nth-child(odd) { animation-delay: -3s; }
  .core { animation: breathe 4.5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes dash { to { stroke-dashoffset: -120; } }
  @keyframes floaty { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @keyframes breathe { 0%,100% { opacity: 1; } 50% { opacity: 0.86; } }
  @media (prefers-reduced-motion: reduce) {
    .link, .sat, .core, .flow { animation: none; }
    .flow { opacity: 0; }
  }
  @media (max-width: 900px) { .hero-visual { margin: 8px auto 0; max-width: 360px; } }
</style>
