---
// 个人 AI 工作系统：中央是「我」的卡通形象，外围是在运行的能力节点
const nodes = [
  { label: "知识门户", x: 220, y: 58, c: "sage" },
  { label: "人才测评", x: 372, y: 132, c: "ochre" },
  { label: "每日资讯", x: 378, y: 300, c: "sage" },
  { label: "培养系统", x: 220, y: 386, c: "ochre" },
  { label: "创作大赛", x: 62, y: 300, c: "sage" },
  { label: "对话演练", x: 68, y: 132, c: "ochre" },
];
---

<div class="hero-visual">
  <svg viewBox="0 0 440 440" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
    <!-- 同心环 -->
    <circle cx="220" cy="220" r="104" fill="#f3efe7" opacity="0.6" />
    <circle cx="220" cy="220" r="150" stroke="#d9d1c3" stroke-width="1" stroke-dasharray="2 6" />
    <circle cx="220" cy="220" r="196" stroke="#eae4d9" stroke-width="1" />

    <!-- 连线 -->
    {nodes.map((n) => <line x1="220" y1="220" x2={n.x} y2={n.y} stroke="#ddd4c6" stroke-width="1.3" class="link" />)}

    <!-- 沿线流动的光点 -->
    {nodes.map((n, i) => (
      <circle r="3.6" class={`flow ${n.c}`}>
        <animateMotion
          dur={`${3.2 + (i % 3) * 0.7}s`}
          repeatCount="indefinite"
          path={`M220,220 L${n.x},${n.y}`}
          begin={`${i * 0.45}s`}
        />
      </circle>
    ))}

    <!-- 外围节点 -->
    {nodes.map((n) => (
      <g class="sat">
        <rect x={n.x - 48} y={n.y - 19} width="96" height="38" rx="19" fill="#ffffff" stroke="#e2dccd" />
        <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="13.5" fill="#45403a" font-family="'Noto Sans SC',sans-serif">{n.label}</text>
      </g>
    ))}
  </svg>

  <!-- 中央：卡通形象 -->
  <div class="hero-core">
    <span class="ring" aria-hidden="true"></span>
    <img src="/me/avatar.jpg" alt="熙熙（Ciki）的卡通形象" width="200" height="200" loading="eager" />
    <span class="name">熙熙 · Ciki</span>
  </div>
</div>

<style>
  .hero-visual { position: relative; width: 100%; max-width: 460px; margin-left: auto; min-width: 0; }
  .hero-visual svg { width: 100%; height: auto; display: block; }
  .link { stroke-dasharray: 4 5; animation: dash 14s linear infinite; }
  .flow.sage { fill: #8d867b; }
  .flow.ochre { fill: #c05a38; }
  .sat { animation: floaty 6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .sat:nth-child(odd) { animation-delay: -3s; }

  .hero-core {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: 9px;
    animation: floaty 7s ease-in-out infinite;
  }
  .hero-core img {
    width: clamp(118px, 31%, 148px); height: auto; aspect-ratio: 1; border-radius: 50%;
    object-fit: cover; border: 3px solid #ffffff;
    box-shadow: 0 6px 22px -8px rgba(33, 29, 25, 0.30);
    background: #f3efe7;
  }
  .hero-core .ring {
    position: absolute; width: clamp(132px, 34.5%, 164px); aspect-ratio: 1; border-radius: 50%;
    border: 1.5px dashed rgba(184, 73, 42, 0.45); top: 0; animation: spin 26s linear infinite;
  }
  .hero-core .name {
    font-family: var(--sans, sans-serif); font-size: 13px; letter-spacing: 0.08em; font-weight: 500;
    color: #76706a; background: rgba(255, 255, 255, 0.85); padding: 2px 10px; border-radius: 999px;
  }
  @keyframes dash { to { stroke-dashoffset: -120; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes floaty { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  .hero-core { animation-name: coreFloat; }
  @keyframes coreFloat { 0%,100% { transform: translate(-50%, -50%); } 50% { transform: translate(-50%, calc(-50% - 6px)); } }
  @media (prefers-reduced-motion: reduce) {
    .link, .sat, .flow, .hero-core, .ring { animation: none; }
    .flow { opacity: 0; }
  }
  @media (max-width: 900px) { .hero-visual { margin: 14px auto 0; width: 100%; max-width: min(330px, 82vw); } }
</style>
