---
import { selectedPractices } from "../data/selected-practices";
---

<div class="practice-outline" aria-label="三组代表实践">
  {selectedPractices.map(item => (
    <article class="outline-item">
      <div class="outline-image">
        <img src={item.image} alt={item.imageAlt} width="1440" height="900" loading="lazy" decoding="async" />
      </div>
      <h3>{item.title}</h3>
      <p class="outline-summary">{item.summary}</p>
      <a class="outline-link" href={item.href}>{item.linkLabel} →</a>
    </article>
  ))}
</div>

<style>
  .practice-outline { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px; border-top:1px solid var(--line-strong); padding-top:24px; }
  .outline-item { min-width:0; display:grid; grid-template-rows:156px auto 1fr auto; align-content:start; gap:14px; }
  .outline-image { min-width:0; overflow:hidden; border:1px solid var(--line); border-radius:var(--r-md); background:var(--paper-2); }
  .outline-image img { display:block; width:100%; height:100%; object-fit:contain; }
  h3 { font-family:var(--serif); font-size:22px; line-height:1.5; margin:0; color:var(--ink); }
  .outline-summary { color:var(--ink-soft); font-size:14px; line-height:1.85; margin:0; }
  .outline-link { display:flex; align-items:center; justify-self:start; min-height:40px; font-size:13px; text-underline-offset:5px; }
  @media(min-width:901px) and (max-width:1150px) {
    h3 { min-height:3em; }
  }
  @media(max-width:900px) {
    .practice-outline { grid-template-columns:1fr; gap:24px; }
    .outline-item { grid-template-columns:164px minmax(0,1fr); grid-template-rows:auto auto auto; gap:10px 24px; padding-bottom:24px; border-bottom:1px solid var(--line); }
    .outline-item:last-child { padding-bottom:0; border-bottom:0; }
    .outline-image { grid-row:1 / 4; align-self:start; aspect-ratio:16/10; }
    h3, .outline-summary, .outline-link { grid-column:2; }
  }
  @media(max-width:600px) {
    .practice-outline { gap:20px; padding-top:20px; }
    .outline-item { grid-template-columns:88px minmax(0,1fr); gap:12px 16px; padding-bottom:20px; }
    .outline-image { grid-column:1; grid-row:1; align-self:center; aspect-ratio:4/3; }
    h3 { grid-column:2; align-self:center; font-size:21px; }
    .outline-summary, .outline-link { grid-column:1 / -1; }
    .outline-summary { font-size:15px; }
  }
</style>
