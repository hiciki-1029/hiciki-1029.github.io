---
import { selectedPractices } from "../data/selected-practices";
import PracticeCover from "./PracticeCover.astro";
---
<div class="practice-outline" aria-label="三组代表实践">
  {selectedPractices.map(item => <article class="outline-item">
    <h3>{item.title}</h3>
    <p class="outline-summary">{item.summary}</p>
    <div class="outline-image"><PracticeCover kind={item.kind} /></div>
    <a class="outline-link" href={item.href}>{item.linkLabel} →</a>
  </article>)}
</div>
<style>
  .practice-outline { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:36px; border-top:1px solid var(--line-strong); padding-top:24px; }
  .outline-item { min-width:0; display:grid; grid-template-rows:auto 1fr 126px auto; align-content:start; gap:13px; border-top:2px solid var(--ochre-soft); padding-top:16px; }
  .outline-image { min-width:0; overflow:hidden; }
  h3 { font-family:var(--serif); font-size:24px; line-height:1.5; margin:0; color:var(--ink); }
  .outline-summary { color:var(--ink-soft); font-size:14px; line-height:1.85; margin:0; }
  .outline-link { display:flex; align-items:center; justify-self:start; min-height:40px; font-size:13px; text-underline-offset:5px; }
  @media(min-width:901px) and (max-width:1150px) { h3 { min-height:3em; } }
  @media(max-width:900px) and (min-width:601px) {
    .practice-outline { gap:20px; }
    .outline-item { grid-template-rows:auto 1fr 104px auto; }
    h3 { font-size:19px; min-height:3em; }
    .outline-summary { font-size:13px; }
  }
  @media(max-width:600px) {
    .practice-outline { grid-template-columns:1fr; gap:24px; padding-top:20px; }
    .outline-item { grid-template-columns:minmax(0,1fr) 104px; grid-template-rows:auto auto auto; gap:8px 18px; padding:0 0 22px; border-top:0; border-bottom:1px solid var(--line); }
    .outline-item:last-child { border-bottom:0; padding-bottom:0; }
    .outline-image { grid-column:2; grid-row:1 / 4; height:116px; align-self:start; }
    h3 { grid-column:1; grid-row:1; font-size:20px; }
    .outline-summary { grid-column:1; grid-row:2; font-size:14px; }
    .outline-link { grid-column:1; grid-row:3; }
  }
</style>
