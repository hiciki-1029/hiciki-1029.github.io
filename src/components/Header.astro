---
const path = Astro.url.pathname;
const nav = [
  { href: "/about/", label: "关于我" },
  { href: "/systems/", label: "AI实践", key: true },
  { href: "/resume/", label: "工作经历" },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="熙熙 · 回到首页">
      <img class="brand-mark" src="/favicon.svg" alt="" width="30" height="30" />
      熙熙<span class="en">CIKI · HICIKI.ME</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {
        nav.map((n) => (
          <a
            href={n.href}
            class={n.key ? "nav-key" : undefined}
            aria-current={isActive(n.href) ? "page" : undefined}
          >
            {n.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
